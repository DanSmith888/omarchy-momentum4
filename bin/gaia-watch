#!/usr/bin/env python3
"""gaia-watch — poll specific GAIA commands and print changes as they happen.

Once a full sweep has narrowed a feature down to a command, this is how you
decode its fields: watch that command, change the setting in the vendor's app,
and read which byte moved. Seconds per experiment instead of a two-minute
sweep each side.

    gaia-watch 0x1a01                  watch one command
    gaia-watch 0x1a01 0x1201 --interval 1
    gaia-watch 0x1a01 --bytes          annotate which byte index changed

Prints the initial value, then a line only when something changes.
"""

import argparse
import os
import sys
import time

M4 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "m4ctl")
# __file__ must be present: m4ctl resolves presets.json relative to it at
# import time, and exec() does not provide one.
_ns = {"__file__": M4}
exec(compile(open(M4).read().replace('if __name__ == "__main__":\n    main()', ""),
             M4, "exec"), _ns)


def diff_bytes(old, new):
    """Indices where two hex strings differ, as byte positions."""
    a = bytes.fromhex(old) if old else b""
    b = bytes.fromhex(new) if new else b""
    out = []
    for i in range(max(len(a), len(b))):
        x = a[i] if i < len(a) else None
        y = b[i] if i < len(b) else None
        if x != y:
            out.append(f"byte[{i}] {x if x is None else f'{x:#04x}'}"
                       f" -> {y if y is None else f'{y:#04x}'}")
    return out


def main():
    ap = argparse.ArgumentParser(prog="gaia-watch", description=__doc__.split("\n")[0])
    ap.add_argument("commands", nargs="+", type=lambda x: int(x, 0))
    ap.add_argument("--mac")
    ap.add_argument("--interval", type=float, default=1.5)
    ap.add_argument("--duration", type=float, default=120.0)
    ap.add_argument("--bytes", action="store_true",
                    help="annotate which byte index changed")
    args = ap.parse_args()

    mac = args.mac or _ns["connected_mac"]()
    if not mac:
        raise SystemExit("gaia-watch: no connected Momentum 4 found (use --mac)")

    last = {}
    end = time.monotonic() + args.duration
    print(f"Watching {', '.join(f'{c:#06x}' for c in args.commands)} "
          f"for {args.duration:.0f}s. Change the setting in the app now.\n",
          file=sys.stderr, flush=True)

    while time.monotonic() < end:
        # Reconnect each cycle: holding the socket open would lock out the
        # phone app, and the app is the thing being used to drive the change.
        try:
            with _ns["Momentum4"](mac) as dev:
                for cmd in args.commands:
                    _, _, payload, ok = dev.exchange(cmd, b"", timeout=1.0)
                    if not ok:
                        continue
                    hexs = payload.hex()
                    prev = last.get(cmd)
                    if prev is None:
                        print(f"  {cmd:#06x}  {hexs}   (initial)", flush=True)
                    elif prev != hexs:
                        note = ""
                        if args.bytes:
                            note = "   " + ", ".join(diff_bytes(prev, hexs))
                        print(f"  {cmd:#06x}  {prev} -> {hexs}{note}", flush=True)
                    last[cmd] = hexs
        except SystemExit as e:
            print(f"  (skipped a cycle: {e})", file=sys.stderr, flush=True)
        time.sleep(args.interval)

    print("\nDone.", file=sys.stderr)


if __name__ == "__main__":
    main()
