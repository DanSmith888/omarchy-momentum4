#!/usr/bin/env python3
"""m4ctl — command-line control for Sennheiser Momentum 4 headphones.

Speaks Qualcomm's GAIA protocol over Bluetooth RFCOMM. Standard library only:
no Qt, no daemon, no background process. Each invocation opens a socket, does
its business and closes.

Battery is read over GAIA too (0x0603), so nothing here needs BlueZ's
experimental interfaces or root.

Protocol constants and the RFCOMM channel-probing approach are derived from
momentum4-control by f3Y0 (https://github.com/f3Y0/momentum4-control), MIT
licensed. That project is a PyQt tray app; this is a headless CLI intended as
a backend for a status-bar widget.

Usage:
  m4ctl get [--json]              show ANC, transparency, bass boost, battery
  m4ctl anc on|off
  m4ctl transparency <0-100>      0 = full ANC, 100 = full transparency
  m4ctl mode adaptive|custom|off  the app's three-way noise control
  m4ctl antiwind off|auto|max     only meaningful in custom mode
  m4ctl bass on|off
  m4ctl battery                   percentage only, from BlueZ
"""

import argparse
import fcntl
import json
import os
import selectors
import signal
import socket
import subprocess
import time
import sys
import stat

MAGIC = b"\xFF\x03"
VENDOR_SENNHEISER = 0x0495

CMD_REGISTER_NOTIFICATION = 0x0007
CMD_SET_BASS_BOOST = 0x1008
CMD_GET_BASS_BOOST = 0x1009
CMD_SET_TRANSPARENCY = 0x1A02
CMD_GET_TRANSPARENCY = 0x1A03
CMD_SET_ANC_STATUS = 0x1A04
CMD_GET_ANC_STATUS = 0x1A05
# Identified by diffing probe captures either side of a firmware update: the
# payload is three big-endian uint16s that matched 2.13.42 and then 3.38.3
# exactly.
CMD_GET_FIRMWARE = 0x1201
# Headphone Controls — the on-cup touch/button controls. Found by sweeping
# either side of the app's switch: exactly one command moved. Note the sense
# is inverted, 0 meaning enabled: it is a "disabled" flag.
# 0x1a01 is a table of (id, value) pairs: 01 vv | 02 vv | 03 vv.
# 0x1a00 writes the whole table back, so a field change is read-modify-write.
CMD_SET_NOISE_TABLE = 0x1A00
CMD_GET_NOISE_TABLE = 0x1A01
# byte[1] is tri-state, not a boolean: the app's Anti-wind switch and its
# Auto/Max sub-setting are the same field. Writing 1 for "on" silently forces
# Max and discards the user's Auto choice, which an earlier version did.
IDX_ANTIWIND = 1
ANTIWIND = {0: "off", 1: "max", 2: "auto"}
ANTIWIND_REV = {v: k for k, v in ANTIWIND.items()}
IDX_UNKNOWN = 3         # byte[3] — never seen non-zero
IDX_ADAPTIVE = 5        # byte[5] — 1 adaptive, 0 custom

# EQ. The getter REQUIRES a payload argument — with an empty payload it
# answers 0x1183 (error), which is why every empty-payload sweep recorded it
# as "rejected" and missed it entirely. The argument's value is ignored; any
# byte returns the active curve. Five signed bytes, one per band.
# Per-band, indexed 0-4. 0x1002 is a per-band *getter*, not the setter — the
# setter is 0x1001 and takes <band><gain>. Whole-curve writes are rejected:
# the app changes a preset by writing each band in turn, which is why the
# notifications arrive one byte at a time.
CMD_SET_EQ_BAND = 0x1001
CMD_GET_EQ_BAND = 0x1002
CMD_GET_EQ = 0x1003
CMD_GET_EQ_FREQ = 0x100B

# The app labels its five bands 63Hz/250Hz/1kHz/4kHz/8kHz. The device reports
# its real parametric centres as 90/325/1500/6500/6500 Hz — note two bands
# share 6500 — so the app's labels are nominal. We show the app's, because
# that is what the user recognises.
EQ_LABELS = ["63Hz", "250Hz", "1kHz", "4kHz", "8kHz"]

# The device stores gain as dB x 10. Confirmed against the app's Rock preset,
# which reads 0/20/25/15/-20 on the wire and 0/2.0/2.5/1.5/-2.0 dB in the UI.
EQ_SCALE = 10.0

# Presets live beside this script rather than in it, so values can be
# corrected without editing code. The headphones have no preset storage of
# their own — applying one just writes the five bands.
PRESETS_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                            os.pardir, "presets.json")


# Hard limits on anything we shell out to. subprocess.run's timeout only
# applies once the child has been read to EOF, so a chatty or wedged helper
# could hold memory and the call open indefinitely. These bounds are enforced
# while reading, and the child gets its own process group so a helper that
# spawns children of its own is cleaned up whole.
MAX_OUTPUT = 64 * 1024      # bytes captured per stream, then we stop and reap
KILL_GRACE = 2.0            # seconds between SIGTERM and SIGKILL


def _reap(proc, grace=KILL_GRACE):
    """End the child's whole process group: TERM, then KILL after `grace`."""
    if proc.poll() is not None:
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            try:
                proc.kill()
            except OSError:
                pass
        try:
            proc.wait(timeout=grace)
            return
        except subprocess.TimeoutExpired:
            continue


def run_bounded(cmd, timeout=6, max_output=MAX_OUTPUT):
    """(returncode, stdout, stderr), bounded in time, bytes and lifetime."""
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, start_new_session=True)
    except OSError as exc:
        return 1, "", str(exc)

    bufs = {proc.stdout: bytearray(), proc.stderr: bytearray()}
    sel = selectors.DefaultSelector()
    for stream in bufs:
        sel.register(stream, selectors.EVENT_READ)

    deadline = time.monotonic() + timeout
    overflowed = False
    try:
        while sel.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _reap(proc)
                return 1, "", "timed out"
            for key, _ in sel.select(timeout=min(0.25, remaining)):
                chunk = key.fileobj.read1(8192)
                if not chunk:
                    sel.unregister(key.fileobj)
                    continue
                buf = bufs[key.fileobj]
                room = max_output - len(buf)
                if room > 0:
                    buf += chunk[:room]
                else:
                    overflowed = True
            if overflowed:
                break
    finally:
        sel.close()

    if overflowed:
        _reap(proc)
    else:
        try:
            proc.wait(timeout=max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            _reap(proc)
            return 1, "", "timed out"
    for stream in (proc.stdout, proc.stderr):
        try:
            stream.close()
        except OSError:
            pass

    def dec(b):
        return bytes(b).decode("utf-8", "replace")

    return (proc.returncode if proc.returncode is not None else 1,
            dec(bufs[proc.stdout]), dec(bufs[proc.stderr]))


def _run(cmd, timeout=6):
    return run_bounded(cmd, timeout=timeout)


def doctor():
    """Check every link between the headphones and the bar widget.

    An absent widget has had three distinct causes so far — a QML fault, the
    widget hiding itself when battery was unreadable, and a polling delay —
    and all three look identical from outside. This says which link is broken.
    """
    checks = []

    def add(ok, label, detail="", fix=""):
        checks.append((ok, label, detail, fix))

    # 1. adapter
    rc, out, _ = _run(["rfkill", "list", "bluetooth"])
    blocked = "Soft blocked: yes" in out
    add(not blocked, "Bluetooth not rfkill-blocked",
        "soft blocked" if blocked else "",
        "rfkill unblock bluetooth")

    rc, out, _ = _run(["bluetoothctl", "show"])
    powered = "Powered: yes" in out
    add(powered, "Adapter powered", "" if powered else "adapter is off",
        "bluetoothctl power on")

    # 2. device
    rc, out, _ = _run(["bluetoothctl", "devices", "Connected"])
    mac = connected_mac()
    add(bool(mac), "Headphones connected",
        mac or "no MOMENTUM device connected",
        "switch them on, or: bluetoothctl connect <mac>")

    if mac:
        usb = _run(["sh", "-c", "grep -qi momentum /proc/asound/cards"])[0] == 0

        # 4. GAIA
        try:
            with Momentum4(mac) as dev:
                fw = dev.firmware()
                pct = dev.battery()
            add(bool(fw), "GAIA control channel", f"firmware {fw}" if fw else "",
                "power-cycle the headphones")
            add(pct is not None, "Battery readable",
                f"{pct}%" if pct is not None
                else ("headphones are on USB — they stop reporting battery "
                      "while plugged in" if usb else "no answer to 0x0603"),
                "" if usb else "unplug USB, or power-cycle the headphones")
        except SystemExit as exc:
            add(False, "GAIA control channel", str(exc),
                "power-cycle the headphones, then reconnect")

    # 5. plugin
    plug = os.path.expanduser("~/.config/omarchy/plugins/" + PLUGIN_ID)
    add(os.path.isdir(plug), "Plugin installed", plug,
        "omarchy plugin add " + REPO_URL + " --enable")
    missing = [f for f in ("BarWidget.qml", "Panel.qml", "manifest.json",
                           "presets.json", "bin/m4status", "bin/m4ctl")
               if not os.path.exists(os.path.join(plug, f))]
    add(not missing, "Plugin files present",
        "missing: " + ", ".join(missing) if missing else "",
        "omarchy plugin update " + PLUGIN_ID)

    # 6. bar layout
    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            layout = json.load(f).get("bar", {}).get("layout", {})
        placed = any(PLUGIN_ID == w.get("id")
                     for sec in layout.values() for w in sec)
    except (OSError, ValueError, AttributeError):
        placed = False
    add(placed, "Widget placed in the bar", "",
        "omarchy plugin enable " + PLUGIN_ID + " --section right")

    width = max(len(c[1]) for c in checks)
    failed = 0
    for ok, label, detail, fix in checks:
        mark = "ok  " if ok else "FAIL"
        line = f"  [{mark}] {label.ljust(width)}"
        if detail:
            line += f"  {detail}"
        print(line)
        if not ok and fix:
            print(f"         -> {fix}")
        failed += 0 if ok else 1
    print()
    if failed:
        print(f"  {failed} check(s) failed.")
    else:
        print("  All checks passed. If the widget is still missing, give it "
              "5s to poll, then: omarchy restart shell")
    return 1 if failed else 0


def load_presets():
    try:
        with open(PRESETS_PATH) as f:
            return json.load(f).get("presets", [])
    except (OSError, ValueError):
        return []
EQ_BANDS = 5

# Sound mode: Graphic EQ vs Speech Clarity. Found by listening rather than
# sweeping — it lives at 0x080x, and the 0x0xxx range was never swept because
# 0x0607 kills the device. 0x0804 reads (and echoes its argument rather than
# writing); 0x0803 writes and takes a 16-bit value.
CMD_GET_SOUND_MODE = 0x0804
CMD_SET_SOUND_MODE = 0x0803
SOUND_MODES = {1: "eq", 2: "speech"}
SOUND_MODES_REV = {v: k for k, v in SOUND_MODES.items()}

CMD_SET_CONTROLS = 0x1606
CMD_GET_CONTROLS = 0x1607

# Battery over GAIA: one byte, percent. This is what removes the need for
# BlueZ's experimental org.bluez.Battery1 — no root anywhere.
CMD_GET_BATTERY = 0x0603

# Auto Power Off, in the 0x06xx power group. The get needs an index byte
# (0x00) — an empty get is rejected with 0x05, which is why no sweep ever
# found it — and answers <index><seconds:u16>. 0 = Never. Smart Control
# offers Never / 15 / 30 / 60 min.
CMD_SET_AUTO_OFF = 0x0600
CMD_GET_AUTO_OFF = 0x0601
AUTO_OFF_CHOICES = {"never": 0, "15": 900, "30": 1800, "60": 3600}

# Plain one-byte booleans (1 = on, not inverted like the touch controls).
# IDs from gjabell/momentumctl, MIT; verified on firmware 3.38.3 by
# probes/decode/momentumctl-verify.json. They sit in the 0x04xx-0x08xx groups
# our sweeps never finished because 0x0607 takes the device offline.
BOOL_FEATURES = {
    "on_head":      (0x0401, 0x0400),   # on-head detection
    "auto_answer":  (0x080B, 0x080A),   # answer calls when put on
    "smart_pause":  (0x080D, 0x080C),   # pause media when taken off
    "comfort_call": (0x0815, 0x0814),   # sidetone during calls
}

# The GAIA service does not always advertise cleanly over SDP, so probe the
# channels it is commonly found on, most likely first.
COMMON_CHANNELS = [2, 1, 15, 14, 12, 3, 4, 5, 6, 7, 8, 9, 10, 11]

# Only one process may hold the GAIA channel. The bar widget polls every 60s
# and a firmware sweep runs for minutes, so without a lock they collide and
# the loser can take the whole session down with it. Everything that opens
# an RFCOMM socket goes through Momentum4, so serialising here covers m4ctl,
# m4status and gaia-probe at once.
# Identity the doctor checks the install against. Must match manifest.json.
PLUGIN_ID = "dansmith888.momentum4"
REPO_URL = "https://github.com/DanSmith888/omarchy-momentum4.git"

# The lock lives in the owner-only runtime dir, never a shared /tmp: a
# predictable path there could be pre-created by another user.
_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR")
if not _RUNTIME_DIR:
    sys.exit("m4ctl: XDG_RUNTIME_DIR is not set; refusing to use a shared temp dir")
# Our own 0700 directory inside the runtime dir, rather than a predictable
# name sitting directly in a shared one. The lock is opened O_NOFOLLOW and
# never truncated, so a symlink planted at the path is refused rather than
# followed and its target clobbered.
_TOOL = "m4ctl"
_STATE_DIR = os.path.join(_RUNTIME_DIR, "dansmith888.momentum4")

_state_fd = None
LOCK_NAME = "lock"


def state_dir_fd():
    """A held, validated descriptor for our private runtime directory.

    Checking a path and then opening through that path leaves a window in
    which the directory can be swapped. We validate the descriptor itself
    (real directory, owned by us, not group/world accessible) and keep it, so
    every later open is relative to the object we checked, not to a name.
    """
    global _state_fd
    if _state_fd is not None:
        return _state_fd
    try:
        os.makedirs(_STATE_DIR, mode=0o700, exist_ok=True)
    except OSError as exc:
        raise SystemExit(f"{_TOOL}: cannot create {_STATE_DIR}: {exc}")
    try:
        fd = os.open(_STATE_DIR,
                     os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as exc:
        raise SystemExit(f"{_TOOL}: cannot open {_STATE_DIR}: {exc}")
    try:
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise SystemExit(f"{_TOOL}: {_STATE_DIR} is not a directory")
        if st.st_uid != os.getuid():
            raise SystemExit(f"{_TOOL}: {_STATE_DIR} is not owned by this user")
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o700)
    except Exception:
        os.close(fd)
        raise
    _state_fd = fd
    return fd


def open_lock():
    """Open the lock file relative to the validated directory descriptor.

    O_NOFOLLOW refuses a symlink at the final component; no O_TRUNC, because
    the contents are irrelevant and truncating whatever is there is the bug.
    """
    dfd = state_dir_fd()
    fd = os.open(LOCK_NAME,
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                 0o600, dir_fd=dfd)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(f"{LOCK_NAME} is not a regular file")
    except Exception:
        os.close(fd)
        raise
    return fd


LOCK_TIMEOUT = 30.0


def build(command, payload=b""):
    return (MAGIC
            + len(payload).to_bytes(2, "big")
            + VENDOR_SENNHEISER.to_bytes(2, "big")
            + command.to_bytes(2, "big")
            + payload)


def expected(command):
    return command | 0x0100


def parse(buffer):
    """Yield (vendor, command, payload) tuples; return leftover bytes."""
    packets, offset = [], 0
    while len(buffer) - offset >= 8:
        if buffer[offset:offset + 2] != MAGIC:
            nxt = buffer.find(MAGIC, offset + 1)
            if nxt == -1:
                return packets, b""
            offset = nxt
            continue
        n = int.from_bytes(buffer[offset + 2:offset + 4], "big")
        total = 8 + n
        if len(buffer) - offset < total:
            break
        packets.append((
            int.from_bytes(buffer[offset + 4:offset + 6], "big"),
            int.from_bytes(buffer[offset + 6:offset + 8], "big"),
            buffer[offset + 8:offset + total],
        ))
        offset += total
    return packets, buffer[offset:]


class Momentum4:
    def __init__(self, mac):
        self.mac = mac
        self.sock = None
        self.buf = b""
        self.channel = None

    def __enter__(self):
        self._lock = os.fdopen(open_lock(), "r+")
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(self._lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise SystemExit(
                        "m4ctl: another process is using the headphones "
                        f"(waited {LOCK_TIMEOUT:.0f}s for {_STATE_DIR}/{LOCK_NAME})")
                time.sleep(0.25)

        errors = []
        for ch in COMMON_CHANNELS:
            try:
                s = socket.socket(socket.AF_BLUETOOTH,
                                  socket.SOCK_STREAM,
                                  socket.BTPROTO_RFCOMM)
                s.settimeout(3.0)
                s.connect((self.mac, ch))
                self.sock, self.buf = s, b""
                _, cmd, payload, ok = self.exchange(CMD_GET_ANC_STATUS, timeout=2.5)
                if ok and payload:
                    self.channel = ch
                    return self
                errors.append(f"ch{ch}: unexpected reply {cmd:#06x}")
            except Exception as exc:
                errors.append(f"ch{ch}: {exc}")
            self.close()
        raise SystemExit("m4ctl: no GAIA channel found on "
                         f"{self.mac}\n  " + "\n  ".join(errors))

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None

    def __exit__(self, *_):
        self.close()
        lock = getattr(self, "_lock", None)
        if lock is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_UN)
                lock.close()
            except OSError:
                pass
            self._lock = None

    def exchange(self, command, payload=b"", timeout=3.0):
        """Return (vendor, command, payload, ok).

        GAIA answers a command with `command | 0x0100` on success and
        `command | 0x0180` on error. Both must be accepted off the socket,
        but they mean opposite things — conflating them makes an unsupported
        feature look like it returned real data. The Momentum 4 rejects
        bass boost this way, replying 0x1189 with a payload of 01, which
        reads as "enabled" if you ignore the error bit.
        """
        self.sock.settimeout(timeout)
        self.sock.sendall(build(command, payload))
        ok_cmd, err_cmd = expected(command), command | 0x0180
        while True:
            packets, self.buf = parse(self.buf)
            for vendor, cmd, data in packets:
                if cmd in (ok_cmd, err_cmd):
                    return vendor, cmd, data, cmd == ok_cmd
            chunk = self.sock.recv(1024)
            if not chunk:
                raise SystemExit("m4ctl: connection closed by device")
            self.buf += chunk

    def firmware(self):
        """major.minor.patch, or None if the device will not report it."""
        _, _, p, ok = self.exchange(CMD_GET_FIRMWARE)
        if not ok or len(p) < 6:
            return None
        parts = [int.from_bytes(p[i:i + 2], "big") for i in (0, 2, 4)]
        return ".".join(str(x) for x in parts)

    def _noise_table(self):
        _, _, p, ok = self.exchange(CMD_GET_NOISE_TABLE)
        return bytearray(p) if (ok and len(p) >= 6) else None

    def _write_noise_field(self, index, value):
        """Read-modify-write one field; the device only accepts the whole table."""
        t = self._noise_table()
        if t is None:
            raise SystemExit("m4ctl: device did not return the noise table")
        t[index] = value
        _, _, _, ok = self.exchange(CMD_SET_NOISE_TABLE, bytes(t))
        if not ok:
            raise SystemExit("m4ctl: device rejected the noise table write")

    def mode(self):
        """'off' | 'adaptive' | 'custom'.

        The app presents one three-way control, but it is two things on the
        wire: ANC on/off lives in 0x1a05, and adaptive-vs-custom is a field in
        the 0x1a01 table. Off wins — when ANC is off the adaptive flag is
        still whatever it was, and means nothing.
        """
        _, _, a, ok = self.exchange(CMD_GET_ANC_STATUS)
        if not ok or not a:
            return None
        if not a[0]:
            return "off"
        t = self._noise_table()
        if t is None:
            return None
        return "adaptive" if t[IDX_ADAPTIVE] else "custom"

    def set_mode(self, mode):
        if mode == "off":
            self.set_anc(False)
            return
        self.set_anc(True)
        self._write_noise_field(IDX_ADAPTIVE, 1 if mode == "adaptive" else 0)

    def antiwind(self):
        """'off' | 'auto' | 'max', or None if unreadable."""
        t = self._noise_table()
        if t is None:
            return None
        return ANTIWIND.get(t[IDX_ANTIWIND], f"unknown({t[IDX_ANTIWIND]})")

    def set_antiwind(self, value):
        if value not in ANTIWIND_REV:
            raise SystemExit(f"m4ctl: anti-wind must be one of "
                             f"{', '.join(ANTIWIND_REV)}")
        self._write_noise_field(IDX_ANTIWIND, ANTIWIND_REV[value])

    def eq(self):
        """Active EQ curve as a list of signed values, or None."""
        _, _, p, ok = self.exchange(CMD_GET_EQ, bytes([0]))
        if not ok or len(p) < EQ_BANDS:
            return None
        return [(v - 256 if v > 127 else v) / EQ_SCALE for v in p[:EQ_BANDS]]

    def eq_frequencies(self):
        """Centre frequency of each band in Hz, or None."""
        out = []
        for b in range(EQ_BANDS):
            _, _, p, ok = self.exchange(CMD_GET_EQ_FREQ, bytes([b]))
            if not ok or len(p) < 3:
                return None
            out.append(int.from_bytes(p[1:3], "big"))
        return out

    def set_eq_curve(self, values):
        """Write all bands. The device has no whole-curve setter, so this
        writes each band in turn — the same thing the phone app does when you
        pick a preset, which is why its notifications arrive one byte at a
        time."""
        for band, gain in enumerate(values[:EQ_BANDS]):
            self.set_eq_band(band, gain)

    def set_eq_band(self, band, gain_db):
        """gain_db is in dB; the device wants dB x 10."""
        if not 0 <= band < EQ_BANDS:
            raise SystemExit(f"m4ctl: band must be 0-{EQ_BANDS - 1}")
        gain = max(-128, min(127, int(round(float(gain_db) * EQ_SCALE))))
        _, _, _, ok = self.exchange(CMD_SET_EQ_BAND,
                                    bytes([band, gain & 0xFF]))
        if not ok:
            raise SystemExit("m4ctl: device rejected the EQ write")

    def sound_mode(self):
        """'eq' | 'speech', or None."""
        _, _, p, ok = self.exchange(CMD_GET_SOUND_MODE)
        if not ok or len(p) < 2:
            return None
        return SOUND_MODES.get(int.from_bytes(p[:2], "big"))

    def set_sound_mode(self, mode):
        if mode not in SOUND_MODES_REV:
            raise SystemExit("m4ctl: sound mode must be eq or speech")
        _, _, _, ok = self.exchange(CMD_SET_SOUND_MODE,
                                    SOUND_MODES_REV[mode].to_bytes(2, "big"))
        if not ok:
            raise SystemExit("m4ctl: device rejected the sound mode")

    def controls(self):
        """True when the on-cup controls are enabled, None if unsupported."""
        _, _, p, ok = self.exchange(CMD_GET_CONTROLS)
        if not ok or not p:
            return None
        return p[0] == 0          # inverted: 0 = enabled

    def set_controls(self, enabled):
        _, _, _, ok = self.exchange(CMD_SET_CONTROLS, bytes([0 if enabled else 1]))
        if not ok:
            raise SystemExit("m4ctl: device rejected controls")

    def battery(self):
        """Percent from GAIA, or None if the device did not answer."""
        _, _, p, ok = self.exchange(CMD_GET_BATTERY)
        return int(p[0]) if (ok and p) else None

    def auto_off(self):
        """Auto Power Off in seconds (0 = never), or None if unsupported."""
        _, _, p, ok = self.exchange(CMD_GET_AUTO_OFF, b"\x00")
        return int.from_bytes(p[1:3], "big") if (ok and len(p) >= 3) else None

    def set_auto_off(self, seconds):
        payload = b"\x00" + int(seconds).to_bytes(2, "big")
        _, _, _, ok = self.exchange(CMD_SET_AUTO_OFF, payload)
        if not ok:
            raise SystemExit("m4ctl: device rejected auto-off")

    def get_bool(self, name):
        """True/False for a BOOL_FEATURES entry, None if unsupported."""
        _, _, p, ok = self.exchange(BOOL_FEATURES[name][0])
        return bool(p[0]) if (ok and p) else None

    def set_bool(self, name, on):
        _, _, _, ok = self.exchange(BOOL_FEATURES[name][1], bytes([1 if on else 0]))
        if not ok:
            raise SystemExit(f"m4ctl: device rejected {name.replace('_', '-')}")

    def state(self):
        """Unsupported features report None, never a value from an error reply."""
        _, _, anc, anc_ok = self.exchange(CMD_GET_ANC_STATUS)
        _, _, tr, tr_ok = self.exchange(CMD_GET_TRANSPARENCY)
        _, _, bb, bb_ok = self.exchange(CMD_GET_BASS_BOOST)
        return {
            "anc": bool(anc[0]) if (anc_ok and anc) else None,
            "transparency": int(tr[0]) if (tr_ok and tr) else None,
            "bass_boost": bool(bb[0]) if (bb_ok and bb) else None,
            "mode": self.mode(),
            "antiwind": self.antiwind(),
            "controls": self.controls(),
            "sound_mode": self.sound_mode(),
            "eq": self.eq(),
            "battery": self.battery(),
            "auto_off": self.auto_off(),
            **{name: self.get_bool(name) for name in BOOL_FEATURES},
            "firmware": self.firmware(),
            "channel": self.channel,
        }

    def set_anc(self, on):
        _, _, _, ok = self.exchange(CMD_SET_ANC_STATUS, bytes([1 if on else 0]))
        if not ok:
            raise SystemExit("m4ctl: device rejected anc "
                             "(feature not supported on this firmware)")

    def set_transparency(self, level):
        _, _, _, ok = self.exchange(CMD_SET_TRANSPARENCY,
                                    bytes([max(0, min(100, int(level)))]))
        if not ok:
            raise SystemExit("m4ctl: device rejected transparency")

    def set_bass(self, on):
        _, _, _, ok = self.exchange(CMD_SET_BASS_BOOST, bytes([1 if on else 0]))
        if not ok:
            raise SystemExit("m4ctl: device rejected bass "
                             "(feature not supported on this firmware)")


def connected_mac():
    """First connected device whose name looks like a Momentum."""
    rc, out, _ = run_bounded(["bluetoothctl", "devices", "Connected"], timeout=5)
    if rc != 0:
        return None
    for line in out.splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) >= 3 and "MOMENTUM" in parts[2].upper():
            return parts[1]
    return None


def main():
    # Shared options live on a parent parser so they are accepted both before
    # and after the subcommand — `m4ctl get --json` is the natural way to type
    # it, and argparse rejects that unless the subparser also knows the flag.
    # SUPPRESS matters: without it the subparser re-declares these with their
    # own defaults and clobbers whatever the top-level parser already set, so
    # `m4ctl --json battery` would silently lose the flag.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--mac", default=argparse.SUPPRESS,
                        help="override device address")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    ap = argparse.ArgumentParser(prog="m4ctl", parents=[common],
                                 description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("get", parents=[common])
    sub.add_parser("battery", parents=[common])
    sub.add_parser("eq", parents=[common])
    sub.add_parser("presets", parents=[common])
    sub.add_parser("doctor", parents=[common])
    p = sub.add_parser("preset", parents=[common])
    p.add_argument("name")
    p = sub.add_parser("eq-set", parents=[common])
    p.add_argument("band", type=int, help=f"0-{EQ_BANDS - 1}")
    p.add_argument("gain", type=float, help="dB, e.g. 2.5 or -2")
    p = sub.add_parser("eq-curve", parents=[common])
    p.add_argument("gains", type=float, nargs=EQ_BANDS,
                   help=f"{EQ_BANDS} gains in dB, one per band")
    p = sub.add_parser("anc", parents=[common])
    p.add_argument("value", choices=["on", "off"])
    p = sub.add_parser("bass", parents=[common])
    p.add_argument("value", choices=["on", "off"])
    p = sub.add_parser("controls", parents=[common])
    p.add_argument("value", choices=["on", "off"])
    for name in BOOL_FEATURES:
        p = sub.add_parser(name.replace("_", "-"), parents=[common])
        p.add_argument("value", choices=["on", "off"])
    p = sub.add_parser("auto-off", parents=[common])
    p.add_argument("value", choices=sorted(AUTO_OFF_CHOICES, key=lambda k: AUTO_OFF_CHOICES[k]),
                   help="minutes until the headphones switch off when idle")
    p = sub.add_parser("sound-mode", parents=[common])
    p.add_argument("value", choices=["eq", "speech"])
    p = sub.add_parser("mode", parents=[common])
    p.add_argument("value", choices=["adaptive", "custom", "off"])
    p = sub.add_parser("antiwind", parents=[common])
    p.add_argument("value", choices=["off", "auto", "max"])
    p = sub.add_parser("transparency", parents=[common])
    p.add_argument("level", type=int, help="0 = full ANC, 100 = full transparency")
    args = ap.parse_args()
    as_json = getattr(args, "json", False)

    if args.cmd == "doctor":
        raise SystemExit(doctor())

    mac = getattr(args, "mac", None) or connected_mac()
    if not mac:
        raise SystemExit("m4ctl: no connected Momentum 4 found (use --mac)")

    if args.cmd == "presets":
        ps = load_presets()
        if as_json:
            print(json.dumps(ps))
        else:
            for e in ps:
                mark = "" if e.get("verified") else "   (unverified)"
                print(f"  {e['name']:10} "
                      + " ".join(f"{g:+.1f}".rjust(6) for g in e["gains"]) + mark)
        return

    if args.cmd == "preset":
        ps = load_presets()
        match = next((e for e in ps
                      if e["name"].lower() == args.name.lower()), None)
        if not match:
            raise SystemExit("m4ctl: no such preset: " + args.name
                             + " (try: m4ctl presets)")
        with Momentum4(mac) as dev:
            dev.set_eq_curve(match["gains"])
        return

    if args.cmd == "eq-curve":
        with Momentum4(mac) as dev:
            dev.set_eq_curve(args.gains)
        return

    if args.cmd == "eq-set":
        with Momentum4(mac) as dev:
            dev.set_eq_band(args.band, args.gain)
        return

    if args.cmd == "eq":
        with Momentum4(mac) as dev:
            curve = dev.eq()
        if curve is None:
            raise SystemExit("m4ctl: device did not return an EQ curve")
        with Momentum4(mac) as dev:
            freqs = dev.eq_frequencies()
        if as_json:
            print(json.dumps({"eq": curve, "frequencies": freqs}))
        else:
            print(" ".join(l.rjust(7) for l in EQ_LABELS))
            print(" ".join(f"{v:+.1f}".rjust(7) for v in curve))
        return

    if args.cmd == "battery":
        with Momentum4(mac) as dev:
            pct = dev.battery()
        if pct is None:
            raise SystemExit("m4ctl: no battery reading (device did not answer)")
        print(json.dumps({"battery": pct}) if as_json else f"{pct}%")
        return

    with Momentum4(mac) as dev:
        if args.cmd == "get":
            st = dev.state()
            st["mac"] = mac
            if as_json:
                print(json.dumps(st))
            else:
                print(f"Mode:         {st.get('mode') or 'unknown'}")
                print(f"Anti-wind:    {st.get('antiwind') or 'unknown'}")
                print(f"Noise level:  {st['transparency']}  (0 = full ANC, 100 = full transparency)")
                bb = st["bass_boost"]
                print(f"Bass boost:   {'unsupported' if bb is None else ('on' if bb else 'off')}")
                print(f"Battery:      {st['battery']}%" if st['battery'] is not None else "Battery:      unknown")
                ct = st.get("controls")
                print(f"Controls:     {'unsupported' if ct is None else ('on' if ct else 'off')}")
                print(f"Sound mode:   {st.get('sound_mode') or 'unknown'}")
                ao = st.get("auto_off")
                print("Auto off:     " + ("unknown" if ao is None else ("never" if ao == 0 else f"{ao // 60} min")))
                for name in BOOL_FEATURES:
                    v = st.get(name)
                    label = (name.replace("_", " ").capitalize() + ":").ljust(14)
                    print(f"{label}{'unsupported' if v is None else ('on' if v else 'off')}")
                eq = st.get("eq")
                if eq:
                    print(f"EQ:           {' '.join(f'{v:+.1f}' for v in eq)} dB")
                if st.get("firmware"):
                    print(f"Firmware:     {st['firmware']}")
        elif args.cmd == "anc":
            dev.set_anc(args.value == "on")
        elif args.cmd == "bass":
            dev.set_bass(args.value == "on")
        elif args.cmd == "sound-mode":
            dev.set_sound_mode(args.value)
        elif args.cmd == "controls":
            dev.set_controls(args.value == "on")
        elif args.cmd == "auto-off":
            dev.set_auto_off(AUTO_OFF_CHOICES[args.value])
        elif args.cmd.replace("-", "_") in BOOL_FEATURES:
            dev.set_bool(args.cmd.replace("-", "_"), args.value == "on")
        elif args.cmd == "mode":
            dev.set_mode(args.value)
        elif args.cmd == "antiwind":
            dev.set_antiwind(args.value)
        elif args.cmd == "transparency":
            dev.set_transparency(args.level)


if __name__ == "__main__":
    main()
