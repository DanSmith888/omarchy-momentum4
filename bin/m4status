#!/usr/bin/env python3
"""m4status — one JSON line describing the connected Momentum 4.

    {"mac": "...", "name": "MOMENTUM 4", "battery": 90,
     "anc_supported": true, "anc": true, "transparency": 100}

Everything, battery included, comes from bin/m4ctl over GAIA. No BlueZ
extras and no root are needed. The BACKENDS table keys off the device name so
that only a Momentum 4 is ever spoken to.

Exits 0 with an empty object when nothing is connected — the widget hides
itself rather than showing a stale value.
"""

import json
import os
import re
import subprocess
import sys
import select
import signal
import time

HERE = os.path.dirname(os.path.abspath(__file__))
TIMEOUT = 10

# Device name pattern -> backend script. Only the Momentum 4 is supported.
BACKENDS = [
    (re.compile(r"MOMENTUM\s*4", re.I), "m4ctl"),
]


# Ceiling on what any one command may hand back.
MAX_OUTPUT = 262144

# Strings that reach the UI come from other programs: bluetoothctl decorates
# its output with ANSI escapes, and a filename is whatever someone called a
# file. Strip escape sequences and control characters and cap the length, so
# nothing can carry terminal control codes or unbounded text into a panel.
_ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
_CTRL = re.compile(r"[\x00-\x1f\x7f]")
TEXT_MAX = 200


def safe_text(value, limit=TEXT_MAX):
    if value is None:
        return None
    out = _CTRL.sub("", _ANSI.sub("", str(value)))
    return out[:limit].strip()



def scrub(value):
    """Sanitise every string in a payload, however deeply nested.

    Applied once at the boundary rather than at each field, so a new field
    added later cannot quietly skip it.
    """
    if isinstance(value, str):
        return safe_text(value)
    if isinstance(value, list):
        return [scrub(v) for v in value]
    if isinstance(value, dict):
        return {k: scrub(v) for k, v in value.items()}
    return value


def _reap(proc, grace=2.0):
    """End the child's whole process group: TERM, then KILL after `grace`."""
    if proc.poll() is not None:
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            try:
                proc.kill()
            except OSError:
                pass
        try:
            proc.wait(timeout=grace)
            return
        except subprocess.TimeoutExpired:
            continue


def run(cmd, timeout=TIMEOUT, limit=MAX_OUTPUT):
    """stdout on success, None on any failure. Never raises, never hangs.

    Reads at most `limit` bytes and enforces `timeout` across the whole read,
    not just around process exit: a command that produces nothing and never
    exits would otherwise block for as long as it liked.
    """
    proc = None
    try:
        # Own process group, so a helper that spawns children is reaped whole.
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL,
                                start_new_session=True)
        fd = proc.stdout.fileno()
        deadline = time.monotonic() + timeout
        chunks, total, truncated = [], 0, False
        while total < limit:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            if not select.select([fd], [], [], remaining)[0]:
                break
            chunk = os.read(fd, min(65536, limit - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        else:
            truncated = True
        proc.stdout.close()
        try:
            rc = proc.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            _reap(proc)
            rc = None
        if not chunks:
            return None
        if rc == 0 or truncated:
            return b"".join(chunks).decode("utf-8", "replace")
        return None
    except Exception:
        if proc is not None:
            try:
                _reap(proc)
            except Exception:
                pass
        return None

def connected_device():
    """(mac, name) of the first connected device that looks like audio."""
    out = run(["bluetoothctl", "devices", "Connected"], timeout=5)
    if not out:
        return None, None
    for line in out.splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) < 3:
            continue
        mac, name = parts[1], parts[2]
        info = run(["bluetoothctl", "info", mac], timeout=5) or ""
        # Audio Sink UUID, or an audio icon — avoids matching mice and keyboards.
        if "0000110b" in info or "audio-" in info:
            return mac, name
    return None, None


def usb_connected(name):
    """True when the headphones are attached to THIS machine over USB.

    This is deliberately NOT called "charging". The signal is that the
    headphones have enumerated as a USB audio card on this host, which happens
    only when plugged into this PC. Charging from a wall adapter or another
    machine is invisible here, and being plugged in does not mean charging is
    happening. The headphones have no charge-state command that we know of.
    """
    try:
        with open("/proc/asound/cards") as f:
            cards = f.read()
    except OSError:
        return None
    key = (name or "").split()[0].upper()
    return bool(key) and key in cards.upper()


def stream_info(mac):
    """(codec, sample_rate_hz) PipeWire negotiated for this device's A2DP sink.

    Read from pactl, not the headphones: what actually plays is decided by the
    PC side, and it is the thing the user can act on (a codec the OS lacks
    cannot be negotiated whatever the headphones offer).
    """
    key = mac.replace(":", "_")
    codec = rate = None
    # Both live on the sink node (the card only lists the profiles on offer).
    sinks = run(["pactl", "list", "sinks"], timeout=5) or ""
    block = sinks.split("bluez_output." + key, 1)
    if len(block) == 2:
        for line in block[1].split("\nSink #", 1)[0].splitlines():
            if "api.bluez5.codec" in line and codec is None:
                codec = line.split("=", 1)[1].strip().strip('"')
            elif "Sample Specification" in line and rate is None:
                for tok in line.split():
                    if tok.endswith("Hz"):
                        try:
                            rate = int(tok[:-2])
                        except ValueError:
                            pass
    names = {"sbc": "SBC", "sbc_xq": "SBC-XQ", "aac": "AAC", "aptx": "aptX",
             "aptx_hd": "aptX HD", "aptx_ll": "aptX LL", "ldac": "LDAC",
             "lc3": "LC3", "opus_05": "Opus"}
    return (names.get(codec, codec) if codec else None), rate


def backend_for(name):
    for pattern, script in BACKENDS:
        if pattern.search(name or ""):
            path = os.path.join(HERE, script)
            if os.access(path, os.X_OK):
                return path
    return None


def main():
    mac, name = connected_device()
    if not mac:
        print("{}")
        return

    codec, rate = stream_info(mac)
    state = {"mac": mac, "name": name, "battery": None,
             "usb_connected": usb_connected(name),
             "codec": codec, "sample_rate": rate,
             "anc_supported": False}

    backend = backend_for(name)
    if backend:
        out = run([backend, "get", "--json"])
        if out:
            try:
                d = json.loads(out)
                state["battery"] = d.get("battery")
                # anc is None when the device rejected the query, so only
                # claim support when a real value came back.
                if d.get("anc") is not None:
                    state["anc_supported"] = True
                    state["anc"] = d["anc"]
                    state["transparency"] = d.get("transparency")
                    # None means the firmware rejected the query, which the
                    # widget shows by hiding the control rather than guessing.
                    state["bass_boost"] = d.get("bass_boost")
                    state["firmware"] = d.get("firmware")
                    state["controls"] = d.get("controls")
                    state["mode"] = d.get("mode")
                    state["antiwind"] = d.get("antiwind")
                    state["eq"] = d.get("eq")
                    state["sound_mode"] = d.get("sound_mode")
                    for k in ("on_head", "auto_answer", "smart_pause", "comfort_call", "auto_off"):
                        state[k] = d.get(k)
            except json.JSONDecodeError:
                pass

    print(json.dumps(scrub(state)))


if __name__ == "__main__":
    main()
