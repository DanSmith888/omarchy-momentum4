#!/usr/bin/env python3
"""m4status — one JSON line describing the connected Momentum 4.

    {"mac": "...", "name": "MOMENTUM 4", "battery": 90,
     "anc_supported": true, "anc": true, "transparency": 100}

Battery comes from BlueZ's org.bluez.Battery1, which only exists when
`Experimental = true` is set in /etc/bluetooth/main.conf.

Everything else is Momentum 4 specific and comes from bin/m4ctl over GAIA.
The BACKENDS table keys off the device name, so an unrecognised headset still
reports battery rather than vanishing from the bar — but none of the controls
will be available.

Exits 0 with an empty object when nothing is connected — the widget hides
itself rather than showing a stale value.
"""

import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
TIMEOUT = 10

# Device name pattern -> backend script. Only the Momentum 4 is supported;
# this is a table rather than a constant so an unknown device degrades to
# battery-only instead of erroring.
BACKENDS = [
    (re.compile(r"MOMENTUM\s*4", re.I), "m4ctl"),
]


def run(cmd, timeout=TIMEOUT):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def connected_device():
    """(mac, name) of the first connected device that looks like audio."""
    out = run(["bluetoothctl", "devices", "Connected"], timeout=5)
    if not out:
        return None, None
    for line in out.splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) < 3:
            continue
        mac, name = parts[1], parts[2]
        info = run(["bluetoothctl", "info", mac], timeout=5) or ""
        # Audio Sink UUID, or an audio icon — avoids matching mice and keyboards.
        if "0000110b" in info or "audio-" in info:
            return mac, name
    return None, None


def battery(mac):
    path = "/org/bluez/hci0/dev_" + mac.replace(":", "_")
    out = run(["busctl", "--system", "get-property", "org.bluez", path,
               "org.bluez.Battery1", "Percentage"], timeout=5)
    if not out:
        return None
    try:
        return int(out.split()[-1])
    except (ValueError, IndexError):
        return None


def usb_connected(name):
    """True when the headphones are attached to THIS machine over USB.

    This is deliberately NOT called "charging". The signal is that the
    headphones have enumerated as a USB audio card on this host, which happens
    only when plugged into this PC. Charging from a wall adapter or another
    machine is invisible here, and being plugged in does not mean charging is
    happening. Neither BlueZ nor UPower can tell us the real thing: Battery1
    exposes only Percentage, so UPower reports state 0, unknown.
    """
    try:
        with open("/proc/asound/cards") as f:
            cards = f.read()
    except OSError:
        return None
    key = (name or "").split()[0].upper()
    return bool(key) and key in cards.upper()


def backend_for(name):
    for pattern, script in BACKENDS:
        if pattern.search(name or ""):
            path = os.path.join(HERE, script)
            if os.access(path, os.X_OK):
                return path
    return None


def main():
    mac, name = connected_device()
    if not mac:
        print("{}")
        return

    # battery() is the generic path, used for any headset. When a device
    # backend runs it reports battery too, from the same source, so the local
    # read is the fallback rather than a second query.
    state = {"mac": mac, "name": name, "battery": None,
             "usb_connected": usb_connected(name),
             "anc_supported": False}

    backend = backend_for(name)
    if not backend:
        state["battery"] = battery(mac)
    if backend:
        out = run([backend, "get", "--json"])
        if out:
            try:
                d = json.loads(out)
                state["battery"] = d.get("battery")
                # anc is None when the device rejected the query, so only
                # claim support when a real value came back.
                if d.get("anc") is not None:
                    state["anc_supported"] = True
                    state["anc"] = d["anc"]
                    state["transparency"] = d.get("transparency")
                    # None means the firmware rejected the query, which the
                    # widget shows by hiding the control rather than guessing.
                    state["bass_boost"] = d.get("bass_boost")
                    state["firmware"] = d.get("firmware")
                    state["controls"] = d.get("controls")
                    state["mode"] = d.get("mode")
                    state["antiwind"] = d.get("antiwind")
                    state["eq"] = d.get("eq")
                    state["sound_mode"] = d.get("sound_mode")
            except json.JSONDecodeError:
                pass

    print(json.dumps(state))


if __name__ == "__main__":
    main()
