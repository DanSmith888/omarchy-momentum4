#!/usr/bin/env python3
"""eq-capture — record each distinct EQ curve as you cycle presets in the app.

The headphones hold only the active curve; the presets live in the phone app.
So the way to learn what "Rock" or "Jazz" actually is, is to select it and read
what the app pushed. This polls the curve and prints each new one as it
settles, in order, so a single pass through the app's preset list captures the
whole set.

    eq-capture --duration 180

Select each preset in turn, leaving a couple of seconds between. Afterwards,
pair the printed curves with the order you clicked.
"""

import argparse
import os
import sys
import time

M4 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "m4ctl")
# __file__ must be present: m4ctl resolves presets.json relative to it at
# import time, and exec() does not provide one.
_ns = {"__file__": M4}
exec(compile(open(M4).read().replace('if __name__ == "__main__":\n    main()', ""),
             M4, "exec"), _ns)


def main():
    ap = argparse.ArgumentParser(prog="eq-capture", description=__doc__.split("\n")[0])
    ap.add_argument("--mac")
    ap.add_argument("--duration", type=float, default=180.0)
    ap.add_argument("--interval", type=float, default=1.0)
    ap.add_argument("--settle", type=float, default=1.5,
                    help="ignore a curve until it has held steady this long; "
                         "the app writes bands one at a time, so mid-transition "
                         "curves would otherwise be recorded as presets")
    args = ap.parse_args()

    mac = args.mac or _ns["connected_mac"]()
    if not mac:
        raise SystemExit("eq-capture: no connected Momentum 4 found")

    labels = _ns["EQ_LABELS"]
    print("  " + " ".join(l.rjust(7) for l in labels), file=sys.stderr)
    print("  Select each preset in the app, a couple of seconds apart.\n",
          file=sys.stderr, flush=True)

    captured = []
    last, stable_since = None, None
    end = time.monotonic() + args.duration
    while time.monotonic() < end:
        try:
            with _ns["Momentum4"](mac) as dev:
                curve = dev.eq()
        except SystemExit:
            time.sleep(args.interval)
            continue
        if curve is None:
            time.sleep(args.interval)
            continue

        now = time.monotonic()
        if curve != last:
            last, stable_since = curve, now
        elif stable_since and now - stable_since >= args.settle:
            if not captured or captured[-1] != curve:
                captured.append(curve)
                print(f"  {len(captured):2}. " +
                      " ".join(f"{v:+.1f}".rjust(7) for v in curve), flush=True)
            stable_since = None
        time.sleep(args.interval)

    print(f"\n  {len(captured)} distinct curves captured.", file=sys.stderr)


if __name__ == "__main__":
    main()
