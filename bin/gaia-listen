#!/usr/bin/env python3
"""gaia-listen — register for GAIA notifications and print whatever the device pushes.

Sweeping asks the device questions. This does the opposite: it registers for
notification features, then sits quietly while you change settings in the
vendor's app, printing every unsolicited packet the headphones send.

That matters because a sweep can only find commands that answer an *empty*
getter. Anything needing an argument — "give me band n of preset m" — is
invisible to it. Three separate sweeps found nothing for EQ, the phone-call
settings or auto-pause, which is exactly the shape of that blind spot.
Notifications sidestep it: the device volunteers the command id itself.

    gaia-listen                 register the known features and listen 120s
    gaia-listen --features 0-32 register a wider range first
    gaia-listen --duration 300

Every packet is printed as vendor/command/payload, with a marker for ones
whose command id we have not seen before.
"""

import argparse
import os
import sys
import time

M4 = os.path.join(os.path.dirname(os.path.abspath(__file__)), "m4ctl")
# __file__ must be present: m4ctl resolves presets.json relative to it at
# import time, and exec() does not provide one.
_ns = {"__file__": M4}
exec(compile(open(M4).read().replace('if __name__ == "__main__":\n    main()', ""),
             M4, "exec"), _ns)

CMD_REGISTER_NOTIFICATION = 0x0007

# From momentum4-control; it registers these but never uses what comes back.
KNOWN_FEATURES = {8: "user EQ", 12: "transparency", 13: "ANC"}

KNOWN_COMMANDS = {
    0x1009: "bass boost", 0x1201: "firmware", 0x1607: "headphone controls",
    0x1A01: "noise table", 0x1A03: "noise level", 0x1A05: "ANC on/off",
}


def main():
    ap = argparse.ArgumentParser(prog="gaia-listen", description=__doc__.split("\n")[0])
    ap.add_argument("--mac")
    ap.add_argument("--duration", type=float, default=120.0)
    ap.add_argument("--features", default="",
                    help="extra feature ids to register, e.g. 0-32 or 8,12,13")
    args = ap.parse_args()

    features = dict(KNOWN_FEATURES)
    if args.features:
        for part in args.features.split(","):
            if "-" in part:
                a, b = part.split("-")
                for f in range(int(a, 0), int(b, 0) + 1):
                    features.setdefault(f, None)
            else:
                features.setdefault(int(part, 0), None)

    mac = args.mac or _ns["connected_mac"]()
    if not mac:
        raise SystemExit("gaia-listen: no connected Momentum 4 found (use --mac)")

    with _ns["Momentum4"](mac) as dev:
        print(f"Connected on channel {dev.channel}. "
              f"Registering {len(features)} notification features…",
              file=sys.stderr, flush=True)
        registered = []
        for f in sorted(features):
            try:
                _, _, _, ok = dev.exchange(CMD_REGISTER_NOTIFICATION,
                                           bytes([f]), timeout=0.8)
                if ok:
                    registered.append(f)
            except Exception:
                pass
        labels = ", ".join(f"{f}" + (f" ({features[f]})" if features.get(f) else "")
                           for f in registered)
        print(f"Registered: {labels or 'none'}", file=sys.stderr)
        print(f"Listening {args.duration:.0f}s — change settings in the app now.\n",
              file=sys.stderr, flush=True)

        dev.sock.settimeout(1.0)
        seen = set()
        end = time.monotonic() + args.duration
        while time.monotonic() < end:
            try:
                chunk = dev.sock.recv(1024)
            except Exception:
                continue
            if not chunk:
                print("  (device closed the connection)", file=sys.stderr)
                break
            dev.buf += chunk
            packets, dev.buf = _ns["parse"](dev.buf)
            for vendor, cmd, payload in packets:
                tag = KNOWN_COMMANDS.get(cmd & ~0x0180)
                mark = "" if cmd in seen else "  <-- NEW"
                seen.add(cmd)
                label = f"  [{tag}]" if tag else ""
                print(f"  vendor={vendor:#06x} cmd={cmd:#06x} "
                      f"payload={payload.hex() or '(empty)'}{label}{mark}", flush=True)

    print("\nDone.", file=sys.stderr)


if __name__ == "__main__":
    main()
