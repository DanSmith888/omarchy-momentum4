#!/usr/bin/env python3
"""gaia-diff — compare two gaia-probe captures.

The workflow this exists for: snapshot, change exactly one setting in the
vendor's phone app, snapshot again, diff. Whatever moved is that feature's
command. It is far more reliable than guessing from command ids, and it gives
you the vendor's own name for what you found.

    gaia-probe --start 0x1000 --end 0x1FFF --delay 0.08 --json > before.json
    #  ... toggle ONE setting in the app ...
    gaia-probe --start 0x1000 --end 0x1FFF --delay 0.08 --json > after.json
    gaia-diff before.json after.json

Only payload changes are reported by default. A command that merely flips
between acked and rejected is reported too, since that is how a firmware
update exposed bass boost.

Change one thing at a time. Two changes at once and you cannot tell which
command belongs to which.
"""

import argparse
import json
import sys


def load(path):
    d = json.load(open(path))
    acked = {e["command"]: e["payload"] for e in d["supported"]}
    rejected = {e["command"] for e in d.get("unsupported", [])}
    known = {e["command"]: e.get("known") for e in d["supported"]}
    return d, acked, rejected, known


def main():
    ap = argparse.ArgumentParser(prog="gaia-diff", description=__doc__.split("\n")[0])
    ap.add_argument("before")
    ap.add_argument("after")
    ap.add_argument("--all", action="store_true",
                    help="include commands whose payload is the bulk ack")
    args = ap.parse_args()

    db, ab, rb, kb = load(args.before)
    da, aa, ra, ka = load(args.after)

    bulk_b = db.get("bulk_ack_payload")
    bulk_a = da.get("bulk_ack_payload")

    changed, appeared, vanished, flipped = [], [], [], []
    for cmd in sorted(set(ab) | set(aa), key=lambda x: int(x, 16)):
        pb, pa = ab.get(cmd), aa.get(cmd)
        if pb == pa:
            continue
        # A command sitting at the bulk ack in both captures carries no state;
        # noise there is just the firmware answering blindly.
        if not args.all and pb in (bulk_b, None) and pa in (bulk_a, None):
            if pb is not None and pa is not None:
                continue
        if pb is None:
            appeared.append((cmd, pa))
        elif pa is None:
            vanished.append((cmd, pb))
        else:
            changed.append((cmd, pb, pa))

    for cmd in sorted(set(rb) ^ set(ra), key=lambda x: int(x, 16)):
        flipped.append((cmd, "rejected -> acked" if cmd in rb else "acked -> rejected"))

    fw_b = db.get("_meta", {}).get("firmware")
    fw_a = da.get("_meta", {}).get("firmware")
    if fw_b or fw_a:
        print(f"firmware: {fw_b or '?'} -> {fw_a or '?'}\n")

    def label(cmd):
        k = ka.get(cmd) or kb.get(cmd)
        return f"  <- {k}" if k else ""

    if changed:
        print("CHANGED payload:")
        for cmd, pb, pa in changed:
            print(f"  {cmd}  {pb or '(empty)'} -> {pa or '(empty)'}{label(cmd)}")
    if appeared:
        print("\nAPPEARED:")
        for cmd, pa in appeared:
            print(f"  {cmd}  -> {pa or '(empty)'}{label(cmd)}")
    if vanished:
        print("\nVANISHED:")
        for cmd, pb in vanished:
            print(f"  {cmd}  {pb or '(empty)'} ->{label(cmd)}")
    if flipped:
        print("\nSUPPORT FLIPPED:")
        for cmd, how in flipped:
            print(f"  {cmd}  {how}{label(cmd)}")

    if not (changed or appeared or vanished or flipped):
        print("No differences. Either nothing changed, or the setting lives "
              "outside the probed range.")


if __name__ == "__main__":
    main()
